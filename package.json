{
  "name": "hydrarecall",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Proof-carrying temporal memory for AI agents, powered by HydraDB.",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node --watch server.mjs",
    "setup": "node scripts/setup-local.mjs",
    "config:migrate-gemini": "node scripts/migrate-gemini-env.mjs",
    "check": "node --check server.mjs && node --check public/app.js && node --check scripts/setup-local.mjs && node --check scripts/longmemeval-adapter.mjs && node --check lib/security.mjs && node --check lib/longmemeval.mjs",
    "auth:create-key": "node scripts/create-api-key.mjs",
    "test:auth": "node scripts/check-production-auth.mjs",
    "test:api": "node scripts/check-api-auth.mjs",
    "eval:longmem": "node scripts/longmemeval-adapter.mjs",
    "eval:longmem:dry": "node scripts/longmemeval-adapter.mjs --input data/fixtures/longmemeval-mini.json --dry-run",
    "eval:longmem:judge": "python scripts/longmemeval-judge-gemini.py",
    "eval:longmem:rerun-fallbacks": "node scripts/rerun-fallbacks.mjs --hypotheses runs/longmemeval/hydrarecall-gemini-lme-s-hypotheses.jsonl --evidence runs/longmemeval/hydrarecall-gemini-lme-s-evidence.jsonl"
  },
  "engines": {
    "node": ">=20"
  }
}
