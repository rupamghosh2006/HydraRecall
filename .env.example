# The app is fully usable without an LLM key in deterministic demo mode.
# Gemini Flash handles claim extraction and LongMemEval grounded reading.
# Create an authorization key in Google AI Studio and keep it server-side.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
# Set to deterministic for reproducible retrieval-only LongMemEval smoke runs.
BENCHMARK_READER_MODE=auto

# Used by the application to authenticate to the self-hosted HydraDB container.
# `npm run setup` generates a strong local value when this is not set.
HYDRADB_AUTH_TOKEN=
HYDRADB_HTTP_URL=http://hydradb:8443
HYDRADB_GRAPH_ID=hydrarecall
HYDRADB_NAMESPACE=hydrarecall
HYDRADB_CELL_ID=cell-0
PORT=3000

# Keep disabled for local demos. Set to api-key for any internet-facing deployment.
# Generate an entry with: npm.cmd run auth:create-key -- production-ui reader+writer
# Store only the resulting hash entry in your secret manager. Never commit the raw key.
AUTH_MODE=disabled
HYDRARECALL_API_KEY_HASHES=
AUTH_RATE_LIMIT_PER_MINUTE=120

# Comma-separated browser origins allowed to call the API. Leave blank for same-origin only.
# Example: CORS_ORIGINS=https://recall.example.com
CORS_ORIGINS=
